/**
 * Goety 仪式条件自定义脚本
 * 
 * 此脚本使用 GoetyEvents 来自定义 Goety 仪式的构建条件
 * 
 * 使用方法：
 * 1. 将此文件放在世界存档的 kubejs/server_scripts/ 目录中
 * 2. 使用 GoetyEvents 事件来创建、修改或删除仪式
 * 3. 重新加载世界或重启服务器
 * 
 * 注意：此脚本运行在服务器端（server_scripts），因为仪式检查是在服务器端进行的
 * 
 * ⚠️ 重要提示：
 * 本文件包含了所有14个内置仪式的完整配置示例，与 Goety 原始实现保持一致。
 * 
 * 如果你直接加载此文件，所有仪式的条件都会被覆盖为这些示例中的配置！
 * 
 * 建议用法：
 * 1. 如果只想修改某个仪式，只复制那个仪式的代码到你自己的脚本
 * 2. 如果想保留原版仪式条件，不要加载整个文件
 * 3. 此文件仅供参考学习，了解每个仪式的原版要求
 */

// ==========================================
// 修改所有内置仪式（完整配置，与 Goety 原始实现一致）
// ==========================================
GoetyEvents.modifyRitual(event => {
    
    // ==========================================
    // 1. forge (锻造仪式)
    // ==========================================
    // 原始需求：1个熔岩炼药锅，2个熔炉或高炉（OR逻辑），1个铁砧
    // 注意：熔炉和高炉是OR逻辑，需要使用条件组
    event.modify('forge',
        // 第一个条件组：熔炉
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                'minecraft:lava_cauldron',        // 1个熔岩炼药锅
                '2x minecraft:furnace',          // 2个熔炉
                'minecraft:anvil'                // 1个铁砧
            ];
        },
        // 第二个条件组：高炉
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                'minecraft:lava_cauldron',        // 1个熔岩炼药锅
                '2x minecraft:blast_furnace',    // 2个高炉
                'minecraft:anvil'                 // 1个铁砧
            ];
        }
    );
    
    // ==========================================
    // 2. animation (活力仪式)
    // ==========================================
    // 原始需求：15个梯子，15个铁轨，1个雕刻南瓜
    event.modify('animation', ritual => {
        ritual.range = 16;
        ritual.blocks = [
            '15x minecraft:ladder',           // 15个梯子
            '15x #minecraft:rails',           // 15个铁轨（使用标签）
            'minecraft:carved_pumpkin'        // 1个雕刻南瓜
        ];
    });
    
    // ==========================================
    // 3. magic (魔法仪式)
    // ==========================================
    // 原始需求：16附魔力（累计），1个讲台（有书），1个附魔台
    // 注意：需要检查附魔力累计值和讲台的书，暂时使用自定义函数
    event.modify('magic', ritual => {
        ritual.range = 16;
        ritual.setRequirement((tileEntity, pos, level) => {
            const RANGE = ritual.range || 16;
            let enchantPower = 0;
            let lecternCount = 0;
            let enchantTableCount = 0;
            
            const Blocks = Java.loadClass('net.minecraft.world.level.block.Blocks');
            const LecternBlockEntity = Java.loadClass('net.minecraft.world.level.block.entity.LecternBlockEntity');
            
            for (let i = -RANGE; i <= RANGE; i++) {
                for (let j = -RANGE; j <= RANGE; j++) {
                    for (let k = -RANGE; k <= RANGE; k++) {
                        const blockPos = pos.offset(i, j, k);
                        const blockState = level.getBlockState(blockPos);
                        const block = blockState.getBlock();
                        
                        // 检查书架（累计附魔力）
                        const power = blockState.getEnchantPowerBonus(level, blockPos);
                        if (power > 0) {
                            enchantPower += power;
                        }
                        
                        // 检查讲台（需要带有书）
                        if (block === Blocks.LECTERN) {
                            const blockEntity = level.getBlockEntity(blockPos);
                            if (blockEntity && LecternBlockEntity.class.isInstance(blockEntity)) {
                                const lectern = Java.cast(blockEntity, LecternBlockEntity);
                                if (!lectern.getBook().isEmpty()) {
                                    lecternCount++;
                                }
                            }
                        }
                        
                        // 检查附魔台
                        if (block === Blocks.ENCHANTING_TABLE) {
                            enchantTableCount++;
                        }
                    }
                }
            }
            
            // 需求：附魔力>=16，讲台>=1（有书），附魔台>=1
            return enchantPower >= 16 && lecternCount >= 1 && enchantTableCount >= 1;
        });
    });
    
    // ==========================================
    // 4. frost (霜冻仪式)
    // ==========================================
    // 原始需求：16个冰，8个雪，4个冰冻灯，或寒冷生物群系（OR逻辑）
    event.modify('frost',
        // 第一个条件组：结构检查（16个冰，8个雪，4个冰冻灯）
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '16x #minecraft:ice',           // 16个冰（使用标签）
                '8x #minecraft:snow',           // 8个雪（使用标签）
                '4x goety:freezing_lamp'        // 4个冰冻灯
            ];
        },
        // 第二个条件组：寒冷生物群系检查
        ritual => {
            ritual.setBiome('coldEnoughToSnow', 'func');  // 调用 biome.coldEnoughToSnow(pos) 方法
        }
    );
    
    // ==========================================
    // 5. necroturgy (死灵仪式)
    // ==========================================
    // 原始需求：16个幽匿块，16个台阶，8个有花的花盆，夜晚，有天空光
    // 注意：需要检查花盆内容，暂时使用自定义函数
    event.modify('necroturgy', ritual => {
        ritual.range = 16;
        ritual.setRequirement((tileEntity, pos, level) => {
            const RANGE = ritual.range || 16;
            let sculkCount = 0;
            let slabCount = 0;
            let flowerPotCount = 0;
            
            const Blocks = Java.loadClass('net.minecraft.world.level.block.Blocks');
            const SculkBlock = Java.loadClass('net.minecraft.world.level.block.SculkBlock');
            const SlabBlock = Java.loadClass('net.minecraft.world.level.block.SlabBlock');
            const FlowerPotBlock = Java.loadClass('net.minecraft.world.level.block.FlowerPotBlock');
            
            for (let i = -RANGE; i <= RANGE; i++) {
                for (let j = -RANGE; j <= RANGE; j++) {
                    for (let k = -RANGE; k <= RANGE; k++) {
                        const blockPos = pos.offset(i, j, k);
                        const blockState = level.getBlockState(blockPos);
                        const block = blockState.getBlock();
                        
                        // 检查幽匿块
                        if (SculkBlock.class.isInstance(block)) {
                            sculkCount++;
                        }
                        
                        // 检查台阶
                        if (SlabBlock.class.isInstance(block)) {
                            slabCount++;
                        }
                        
                        // 检查花盆（必须包含花）
                        if (FlowerPotBlock.class.isInstance(block)) {
                            const flowerPotBlock = Java.cast(block, FlowerPotBlock);
                            if (flowerPotBlock.getContent() !== Blocks.AIR) {
                                flowerPotCount++;
                            }
                        }
                    }
                }
            }
            
            // 需求：16个幽匿块，16个台阶，8个有花的花盆
            const structureCheck = sculkCount >= 16 && slabCount >= 16 && flowerPotCount >= 8;
            
            // 额外条件：夜晚（getSkyDarken >= 4）和维度有天空光
            const timeCheck = level.getSkyDarken() >= 4 && level.dimensionType().hasSkyLight();
            
            return structureCheck && timeCheck;
        });
    });
    
    // ==========================================
    // 6. geoturgy (大地仪式)
    // ==========================================
    // 原始需求：8个紫水晶块，1个锻造台，16个深板岩（solidRender），或（看不到天空 AND 高度<=32）
    // 使用多函数参数实现 OR 逻辑
    // 注意：条件组内部是 AND 逻辑，多个条件组之间是 OR 逻辑
    event.modify('geoturgy',
        // 第一个条件组：结构检查
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '8x minecraft:amethyst_block',  // 8个紫水晶块
                'minecraft:smithing_table',     // 1个锻造台
                // 注意：原版检查深板岩的 solidRender 属性（实心渲染），这里用标签代替
                '16x #minecraft:deepslate'      // 16个深板岩（使用标签代替 solidRender 检查）
            ];
        },
        // 第二个条件组：环境检查（OR 逻辑）
        ritual => {
            ritual.setRequireSkyVisible(false);  // 看不到天空
            ritual.setMaxY(32);                  // 高度 <= 32
        }
    );
    
    // ==========================================
    // 7. lich (大师死灵仪式)
    // ==========================================
    // 注意：lich 不是一个独立的仪式类型，不支持修改
    // 
    // 在 Goety 中，lich 相关的仪式（如 undeath_potion）使用：
    // - craftType: "necroturgy"（使用 necroturgy 的结构检查）
    // - research: "forbidden"（通过 research 字段区分）
    // 
    // lich 不存在于 RitualType 中，因此不支持通过 event.modify('lich', ...) 来修改
    // 
    // 如果需要修改 lich 仪式的结构，应该修改 necroturgy 仪式类型：
    // event.modify('necroturgy', ritual => { ... });
    // 
    // 但请注意：修改 necroturgy 会影响所有使用 necroturgy 结构的仪式
    // 如果只想修改 lich 相关的仪式，需要通过其他方式
    
    // ==========================================
    // 8. sky (天空仪式)
    // ==========================================
    // 原始需求：8个大理石块，16个玉石块，4个凹金块，或高度>=128或Aether维度
    // 使用多函数参数实现 OR 逻辑
    // 注意：条件组内部是 AND 逻辑，多个条件组之间是 OR 逻辑
    event.modify('sky',
        // 第一个条件组：结构检查
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '8x #goety:marble_blocks',      // 8个大理石块（使用 Goety 标签）
                '16x #goety:jade_blocks',        // 16个玉石块（使用 Goety 标签）
                '4x #goety:indented_gold_blocks' // 4个凹金块（使用 Goety 标签）
            ];
        },
        // 第二个条件组：高度检查（OR 逻辑）
        ritual => {
            ritual.setMinY(128);  // 高度 >= 128
        },
        // 第三个条件组：Aether维度检查（OR 逻辑）
        ritual => {
            ritual.setDimension('aether', true);  // 维度ID包含 'aether'（模糊匹配）
        }
    );
    
    // ==========================================
    // 9. storm (风暴仪式)
    // ==========================================
    // 原始需求：12个铜相关方块，4个避雷针，20个锁链，天空仪式条件（OR），雷雨，能看到天空
    // 注意：storm 需要同时满足：结构 AND skyRitual条件 AND 雷雨 AND 能看到天空
    // skyRitual条件：高度>=128 OR Aether维度 OR 天空仪式结构
    // 使用多函数参数实现 OR 逻辑，拆分为3个条件组
    // 原逻辑：结构 AND (高度>=128 OR Aether维度 OR 天空结构) AND 雷雨 AND 能看到天空
    // = (结构 AND 高度>=128 AND 雷雨 AND 能看到天空) OR (结构 AND Aether维度 AND 雷雨 AND 能看到天空) OR (结构 AND 天空结构 AND 雷雨 AND 能看到天空)
    event.modify('storm',
        // 第一个条件组：结构检查 AND 高度>=128 AND 雷雨 AND 能看到天空
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '12x #minecraft:copper_ores',      // 12个铜相关方块（使用标签）
                '4x minecraft:lightning_rod',      // 4个避雷针
                '20x minecraft:chain'              // 20个锁链
            ];
            ritual.setWeather('thunder');          // 需要雷雨天气
            ritual.setRequireSkyVisible(true);     // 需要能看到天空
            ritual.setMinY(128);                   // 高度 >= 128
        },
        // 第二个条件组：结构检查 AND Aether维度 AND 雷雨 AND 能看到天空
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '12x #minecraft:copper_ores',      // 12个铜相关方块（使用标签）
                '4x minecraft:lightning_rod',      // 4个避雷针
                '20x minecraft:chain'              // 20个锁链
            ];
            ritual.setWeather('thunder');          // 需要雷雨天气
            ritual.setRequireSkyVisible(true);     // 需要能看到天空
            ritual.setDimension('aether', true);  // 维度ID包含 'aether'（模糊匹配）
        },
        // 第三个条件组：结构检查 AND 天空仪式结构 AND 雷雨 AND 能看到天空（完全配置化）
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '12x /copper/',                    // 12个铜相关方块（正则匹配）
                '4x minecraft:lightning_rod',      // 4个避雷针
                '20x minecraft:chain',             // 20个锁链
                // 天空仪式结构需求（所有31种大理石变体、15种玉石变体、3种凹金块变体都有效）
                '8x #goety:marble_blocks',         // 8个大理石块（使用标签支持所有变体）
                '16x #goety:jade_blocks',          // 16个玉石块（使用标签支持所有变体）
                '4x #goety:indented_gold_blocks'   // 4个凹金块（使用标签支持所有变体）
            ];
            ritual.setWeather('thunder');          // 需要雷雨天气
            ritual.setRequireSkyVisible(true);     // 需要能看到天空
        }
    );
    
    // ==========================================
    // 10. sabbath (安息仪式)
    // ==========================================
    // 原始需求：8个哭泣黑曜石，16个黑曜石，4个灵魂火
    event.modify('sabbath', ritual => {
        ritual.range = 16;
        ritual.blocks = [
            '8x minecraft:crying_obsidian',    // 8个哭泣黑曜石
            '16x minecraft:obsidian',          // 16个黑曜石
            '4x minecraft:soul_fire'           // 4个灵魂火
        ];
    });
    
    // ==========================================
    // 11. adept_nether (进阶下界仪式)
    // ==========================================
    // 原始需求：8个玄武岩相关方块，16个黑石相关方块，4个荧石，下界维度或生物群系
    // 使用多函数参数实现 OR 逻辑（结构 OR 维度）
    // 注意：条件组内部是 AND 逻辑，多个条件组之间是 OR 逻辑
    // 原逻辑：结构 AND (维度 OR 生物群系) = (结构 AND 维度) OR (结构 AND 生物群系)
    event.modify('adept_nether',
        // 第一个条件组：结构检查 AND 维度检查
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '8x /basalt/',              // 8个玄武岩相关方块（正则匹配）
                '16x /blackstone/',         // 16个黑石相关方块（正则匹配）
                '4x minecraft:glowstone'    // 4个荧石
            ];
            // 条件组内部是 AND 逻辑，所以这里需要同时满足：结构 AND 维度
            ritual.setDimension('minecraft:the_nether');  // 下界维度
        },
        // 第二个条件组：结构检查 AND 生物群系检查
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '8x /basalt/',              // 8个玄武岩相关方块（正则匹配）
                '16x /blackstone/',         // 16个黑石相关方块（正则匹配）
                '4x minecraft:glowstone'    // 4个荧石
            ];
            // 条件组内部是 AND 逻辑，所以这里需要同时满足：结构 AND 生物群系
            ritual.setBiome('#minecraft:is_nether', 'tags');  // 下界生物群系标签
        }
    );
    
    // ==========================================
    // 12. expert_nether (专家下界仪式)
    // ==========================================
    // 原始需求：4个凋灵骷髅头，32个下界砖，8个下界疣，下界维度或生物群系
    // 使用多函数参数实现 OR 逻辑（结构 OR 维度）
    // 注意：条件组内部是 AND 逻辑，多个条件组之间是 OR 逻辑
    // 原逻辑：结构 AND (维度 OR 生物群系) = (结构 AND 维度) OR (结构 AND 生物群系)
    event.modify('expert_nether',
        // 第一个条件组：结构检查 AND 维度检查
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '4x minecraft:wither_skeleton_skull',  // 4个凋灵骷髅头（包括墙上的）
                '32x minecraft:nether_bricks',          // 32个下界砖
                '8x minecraft:nether_wart'             // 8个下界疣
            ];
            ritual.setDimension('minecraft:the_nether');  // 下界维度
        },
        // 第二个条件组：结构检查 AND 生物群系检查
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '4x minecraft:wither_skeleton_skull',  // 4个凋灵骷髅头（包括墙上的）
                '32x minecraft:nether_bricks',          // 32个下界砖
                '8x minecraft:nether_wart'             // 8个下界疣
            ];
            ritual.setBiome('#minecraft:is_nether', 'tags');  // 下界生物群系标签
        }
    );
    
    // ==========================================
    // 13. end (末地仪式)
    // ==========================================
    // 原始需求：16个虚空块，64个末地石/末地石砖，32个紫珀相关方块，末地维度或末地生物群系
    // 使用多函数参数实现 OR 逻辑（结构 OR 维度）
    // 注意：条件组内部是 AND 逻辑，多个条件组之间是 OR 逻辑
    event.modify('end',
        // 第一个条件组：结构检查 AND 维度检查
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '16x goety:void_block',              // 16个虚空块
                '64x #goety:end_stone',              // 64个末地石（使用 Goety 标签，包括末地石砖）
                '32x #minecraft:purpur'              // 32个紫珀相关方块（使用标签）
            ];
            ritual.setDimension('minecraft:the_end');  // 末地维度
        },
        // 第二个条件组：结构检查 AND 生物群系检查
        ritual => {
            ritual.range = 16;
            ritual.blocks = [
                '16x goety:void_block',              // 16个虚空块
                '64x #goety:end_stone',              // 64个末地石（使用 Goety 标签，包括末地石砖）
                '32x #minecraft:purpur'              // 32个紫珀相关方块（使用标签）
            ];
            ritual.setBiome('#minecraft:is_end', 'tags');  // 末地生物群系标签
        }
    );
    
    // ==========================================
    // 14. deep (深渊仪式)
    // ==========================================
    // 原始需求：4个海晶灯，16个海晶相关方块，16个花岗岩相关方块，深海环境或结构检查
    // 特殊要求：祭坛必须被水淹没（waterlogged=true）
    // 使用多函数参数实现 OR 逻辑
    // 注意：深海环境指的是高度<=海平面 AND 深海生物群系
    event.modify('deep',
        // 第一个条件组：深海环境检查（高度<=海平面 AND 深海生物群系）
        ritual => {
            ritual.setRequireAltarWaterlogged(true);  // 祭坛必须被水淹没
            ritual.setMaxY(63);  // 假设海平面为64，高度<=63
            ritual.setBiome('#minecraft:is_deep_ocean', 'tags');  // 深海生物群系
        },
        // 第二个条件组：结构检查（完全配置化，使用正则表达式）
        ritual => {
            ritual.range = 16;
            ritual.setRequireAltarWaterlogged(true);  // 祭坛必须被水淹没
            // 注意：使用 KubeJS 原生支持的正则表达式匹配方块
            // 格式：/pattern/ 会匹配所有 ID 包含 pattern 的方块
            ritual.blocks = [
                '4x minecraft:sea_lantern',     // 4个海晶灯
                '16x /prismarine/',             // 16个海晶相关方块（正则匹配）
                '16x /granite/'                 // 16个花岗岩相关方块（正则匹配）
            ];
        }
    );
});

// ==========================================
// 创建新仪式类型示例
// ==========================================
GoetyEvents.registerRitual(event => {
    // 创建自定义仪式：钻石仪式
    event.create('diamond_ritual', ritual => {
        ritual.range = 16;
        ritual.blocks = [
            '5x minecraft:diamond_block',    // 5个钻石块
            '3x minecraft:emerald_block'    // 3个绿宝石块
        ];
    });
});

/**
 * ==========================================
 * 使用说明
 * ==========================================
 * 
 * 配置化方式：
 * 1. ritual.range - 扫描范围（整数，默认16）
 * 2. ritual.blocks - 方块需求，支持多种格式：
 *    - 字符串：'9x minecraft:stone' - 单个方块需求
 *    - 数组：['9x minecraft:stone', '3x minecraft:diamond_block'] - 多个方块需求
 *    - 正则表达式：'/pattern/' 或 '16x /pattern/' - 匹配包含指定模式的方块
 *    - 标签：'#minecraft:planks' 或 '9x #minecraft:planks' - 使用标签
 *    - 模组：'@minecraft' - 匹配指定模组的所有方块
 *    - 支持使用 Item.of() 创建带 NBT 的物品栈
 * 3. ritual.setDimension(dimensionId) - 维度限制（精确匹配，默认）
 * 4. ritual.setDimension(dimensionId, containsMatch) - 维度限制
 *    - dimensionId: 维度ID，如 'minecraft:the_nether' 或 'aether'
 *    - containsMatch: false（精确匹配，默认）或 true（模糊匹配）
 *    示例：
 *      - ritual.setDimension('minecraft:the_nether')  // 精确匹配（默认）
 *      - ritual.setDimension('aether', true)           // 模糊匹配
 * 5. ritual.setWeather(weather) - 天气要求：'thunder'（雷雨）、'rain'（下雨）、'clear'（晴天）
 * 6. ritual.setTimeOfDay(timeOfDay) - 时间要求：'day'（白天）、'night'（夜晚）
 * 7. ritual.setBiome(biomeValue, type) - 生物群系要求
 *    - biomeValue: 生物群系值（可以是字符串或数组），或方法名（当 type='func' 时）
 *    - type: 'id'（生物群系ID，默认）、'tags'（标签）、'func'（方法调用）
 *    示例：
 *      - ritual.setBiome('minecraft:plains')                    // 单个ID（默认type='id'）
 *      - ritual.setBiome(['minecraft:plains', 'minecraft:forest'], 'id')  // 多个ID（OR 逻辑）
 *      - ritual.setBiome('#minecraft:is_nether', 'tags')      // 标签检查
 *      - ritual.setBiome(['#minecraft:is_nether', '#minecraft:is_ocean'], 'tags')  // 多个标签（OR 逻辑）
 *      - ritual.setBiome('coldEnoughToSnow', 'func')          // 方法调用：biome.coldEnoughToSnow(pos)
 *      - 注意：使用 'func' 类型时必须显式指定第二个参数，支持任何 Biome 类的布尔方法
 * 8. ritual.setMinY(y) - 最小高度要求
 * 9. ritual.setMaxY(y) - 最大高度要求
 * 10. ritual.setRequireSkyVisible(boolean) - 是否需要看到天空（true/false）
 * 11. ritual.setRequireAltarWaterlogged(boolean) - 是否需要祭坛含水（true/false）
 * 12. ritual.setRequirement(function) - 自定义检查函数（可选），如果设置了会完全覆盖所有配置检查
 * 
 * 
 * ==========================================
 * 多函数参数（OR 逻辑）
 * ==========================================
 * 
 * 语法示例：
 * 
 * GoetyEvents.modifyRitual(event => {
 *     event.modify('ritual_id', 
 *         ritual => {
 *             // 第一个条件组
 *         },
 *         ritual => {
 *             // 第二个条件组
 *         }
 *         // 可以传入多个函数，任意一个满足即可
 *     );
 * });
 * 
 * ==========================================
 * 重要说明
 * ==========================================
 * - ritual.blocks 和 ritual.setRequirement() 不需要同时设置
 * - 如果设置了 ritual.setRequirement()，它会完全覆盖所有配置检查（blocks、weather、timeOfDay 等）
 * - 如果只使用配置化方式，会按顺序检查：维度 -> 天气 -> 时间 -> 生物群系 -> 高度 -> 天空可见性 -> 方块需求
 * - 条件组内部是 AND 逻辑：每个条件组内的所有配置（blocks、weather、timeOfDay等）都需要满足
 * - 条件组之间是 OR 逻辑：多个条件组之间，任意一个满足即可
 * - 如果条件组内需要 OR 逻辑（如下界维度 OR 下界生物群系），需要使用自定义函数 ritual.setRequirement()
 * - 如果两者都不设置，仪式可能无法正常工作（建议至少设置 blocks）
 * 
 * 使用建议：
 * - 简单需求：只使用 ritual.blocks（推荐）
 * - 需要特殊条件：使用配置化方式（ritual.setWeather(), ritual.setTimeOfDay() 等）
 * - 复杂需求：只使用 ritual.setRequirement()（完全自定义检查逻辑）
 * - OR 逻辑：使用多函数参数 event.modify('id', func1, func2, ...)
 * 
 * KubeJS 方块格式支持（原生功能）：
 * - 'minecraft:stone' - 单个方块（默认为 1 个，不需要写 1x）
 * - '9x minecraft:stone' - 指定数量
 * - '/pattern/' 或 '16x /pattern/' - 正则表达式匹配
 *   示例：'/prismarine/' 匹配所有包含 'prismarine' 的方块（海晶石、海晶石砖、海晶石台阶等）
 *   示例：'/.*copper.*/' 匹配所有包含 'copper' 的方块
 *   示例：'/granite/i' 不区分大小写匹配（i = case insensitive）
 * - '#minecraft:planks' 或 '9x #minecraft:planks' - 标签
 * - '@minecraft' - 匹配指定模组的所有方块
 * - '%minecraft:building_blocks' - 匹配创造标签页
 * - '*' - 通配符（匹配所有方块）
 * - '#minecraft:logs' - 使用标签
 * - Item.of('minecraft:stone') - 使用 ItemStack 对象，支持 NBT
 * - Item.of('minecraft:stone', {nbt: 'data'}) - 带 NBT 的物品栈
 * 
 * ==========================================
 * 支持的仪式类型（共14个）
 * ==========================================
 * 
 * 1. forge (锻造仪式)
 * 2. animation (活力仪式)
 * 3. magic (魔法仪式)
 * 4. frost (霜冻仪式)
 * 5. necroturgy (死灵仪式)
 * 6. geoturgy (大地仪式)
 * 7. sky (天空仪式)
 * 8. storm (风暴仪式)
 * 9. sabbath (安息仪式)
 * 10. adept_nether (进阶下界仪式)
 * 11. expert_nether (专家下界仪式)
 * 12. end (末地仪式)
 * 13. deep (深渊仪式)
 * 
 * 注意：lich (大师死灵仪式) 不是一个独立的仪式类型
 * - lich 相关的仪式使用 craftType: "necroturgy"
 * - 通过 research: "forbidden" 来区分
 * - 不支持通过 event.modify('lich', ...) 来修改
 * - 如果需要修改，应修改 necroturgy 仪式类型
 * 
 * 内置仪式的特殊需求说明：
 * 
 * 可以直接使用 ritual.blocks 配置的仪式：
 * - forge (锻造仪式) - 只需要方块结构
 * - animation (活力仪式) - 只需要方块结构
 * - sabbath (安息仪式) - 只需要方块结构
 * 
 * 需要使用配置化方式（结合 ritual.setWeather() 等）的仪式：
 * - storm (风暴仪式) - ritual.setWeather('thunder'), ritual.setMinY(128), ritual.setRequireSkyVisible(true)
 * - sky (天空仪式) - ritual.setMinY(128) 或结构检查
 * - adept_nether (进阶下界仪式) - ritual.setDimension('minecraft:the_nether') 或 ritual.setBiome('#minecraft:is_nether', 'tags')
 * - expert_nether (专家下界仪式) - ritual.setDimension('minecraft:the_nether') 或 ritual.setBiome('#minecraft:is_nether', 'tags')
 * 
 * 需要使用多函数参数（OR 逻辑）的仪式：
 * - forge (锻造仪式) - 熔炉或高炉（OR逻辑）
 * - frost (霜冻仪式) - 结构检查（16个冰，8个雪，4个冰冻灯）OR 寒冷生物群系检查（ritual.setBiome('coldEnoughToSnow', 'func')）
 * - geoturgy (大地仪式) - 结构检查 OR 环境检查（看不到天空 AND 高度<=32）
 * - sky (天空仪式) - 结构检查 OR 高度检查（>=128）
 * - adept_nether (进阶下界仪式) - 结构检查 OR 维度检查
 * - expert_nether (专家下界仪式) - 结构检查 OR 维度检查
 * - end (末地仪式) - 结构检查 OR 维度检查
 * - deep (深渊仪式) - 深海环境检查 OR 结构检查（同时需要水淹没检查）
 * - storm (风暴仪式) - 多个条件组（结构 AND 高度 AND 天气 AND 天空可见性）OR ...
 * 
 * 需要自定义函数 ritual.setRequirement() 的仪式（因为需要特殊检查）：
 * - magic (魔法仪式) - 需要检查附魔力（书架）和讲台的书
 *   TODO: 未来通过 ritual.setMinEnchantPower() 和 ritual.setRequireLecternWithBook() 实现
 * - necroturgy (死灵仪式) - 需要检查花盆内容（花盆必须有花）
 *   TODO: 未来通过 ritual.setRequireFlowerPotWithContent() 实现
 * - deep (深渊仪式) - 需要检查祭坛是否被水淹没（waterlogged属性）
 *   注意：这是一个特殊的仪式，祭坛本身必须被水淹没才能使用
 * 
 * 注意：大部分仪式现在都可以通过配置化方式实现，只有极少数需要自定义函数。
 * 
 * 示例：禁用内置仪式
 * 
 * GoetyEvents.modifyRitual(event => {
 *     event.modify('storm', ritual => {
 *         ritual.setRequirement(() => false); // 始终返回 false，禁用仪式
 *     });
 * });
 * 
 * 示例：复杂自定义检查
 * 
 * GoetyEvents.modifyRitual(event => {
 *     event.modify('storm', ritual => {
 *         ritual.setRequirement((tileEntity, pos, level) => {
 *             // 完全自定义的检查逻辑
 *             return true;
 *         });
 *     });
 * });
 * 
 * 本地化（可选）：
 * 如果你创建了新的仪式类型，可以在世界存档的 kubejs/assets/goety/lang/ 目录下添加语言文件：
 * 
 * zh_cn.json:
 * {
 *   "jei.goety.craftType.diamond_ritual": "钻石仪式",
 *   "jei.goety.craftType.flame_ritual": "火焰仪式"
 * }
 * 
 * 本地化键格式：jei.goety.craftType.<ritualId>
 * 如果不添加本地化，仪式名称会显示为仪式 ID。
 */