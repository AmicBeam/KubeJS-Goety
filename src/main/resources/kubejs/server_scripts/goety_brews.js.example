/**
 * Goety 药酿配置示例脚本
 * 
 * 本脚本展示了如何使用 GoetyEvents.registerBrew() 来配置药酿系统：
 * - 容量剂（Capacity Modifiers）
 * - 增强剂（Augmentation Modifiers）
 * 
 * 注意：添加催化剂（酿造配方）请使用 event.recipes.goety.brewing
 * 
 * 使用方法：
 * 1. 将此文件放在世界存档的 kubejs/server_scripts/ 目录中
 * 2. 根据需要修改配置
 * 3. 重新加载世界或重启服务器
 */

GoetyEvents.registerBrew(event => {
    
    // ==========================================
    // 1. 容量剂配置（Capacity Modifiers）
    // ==========================================
    // event.addCapacity(item, level)
    // - item: 物品ID（字符串）或物品对象
    // - level: 等级（0-7）
    
    // 添加自定义容量剂
    event.addCapacity('mymod:magic_crystal', 6);
    event.addCapacity('mymod:soul_crystal', 7);
    
    // 覆盖原版容量剂（可选）
    // event.addCapacity('minecraft:nether_wart', 0);  // 会覆盖原版配置
    
    
    // ==========================================
    // 2. 增强剂配置（Augmentation Modifiers）
    // ==========================================
    // event.addAugmentation(item, modifier, level)
    // - item: 物品ID（字符串）或物品对象
    // - modifier: 增强类型（字符串）
    //   - 'capacity' - 容量
    //   - 'duration' - 持续时间
    //   - 'amplifier' - 效果放大
    //   - 'aoe' - 范围效果
    //   - 'linger' - 持续效果
    //   - 'quaff' - 饮用效果
    //   - 'velocity' - 速度
    //   - 'aquatic' - 水生
    //   - 'fire_proof' - 防火
    // - level: 等级（整数）
    
    // 添加自定义增强剂
    event.addAugmentation('mymod:time_crystal', 'duration', 3);
    event.addAugmentation('mymod:power_crystal', 'amplifier', 2);
    event.addAugmentation('mymod:range_crystal', 'aoe', 1);
    
    // 修改原版增强剂（直接覆盖）
    event.addAugmentation('minecraft:redstone', 'duration', 1);  // 提升等级
    
    
    // ==========================================
    // 3. 移除配置（可选）
    // ==========================================
    // 注意：移除功能目前仅提供警告提示
    // 实际移除需要通过覆盖注册来实现
    
    // event.removeCapacity('minecraft:nether_wart');
    // event.removeAugmentation('minecraft:redstone');
    // 移除内置催化剂，内置催化剂无法通过recipe删除
    // event.removeCatalyst('minecraft:grass');
    
    
    // ==========================================
    // 完整示例：自定义药酿套装
    // ==========================================
    
    // 自定义容量剂套装
    event.addCapacity('mymod:magic_crystal_tier1', 1);
    event.addCapacity('mymod:magic_crystal_tier2', 2);
    event.addCapacity('mymod:magic_crystal_tier3', 3);
    
    // 自定义增强剂套装
    event.addAugmentation('mymod:duration_crystal', 'duration', 2);
    event.addAugmentation('mymod:amplifier_crystal', 'amplifier', 2);
    event.addAugmentation('mymod:range_crystal', 'aoe', 2);
});

// ==========================================
// 添加催化剂请使用 event.recipes.goety.brewing
// ==========================================
// 示例：
// ServerEvents.recipes(event => {
//     event.recipes.goety.brewing('mymod:fire_essence', 'minecraft:fire_resistance')
//         .soulCost(50)
//         .duration(3600);
// });

